* text=auto

*.ps1 text eol=crlf
*.cs text eol=crlf
*.manifest text eol=crlf
*.lua text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.ini text eol=crlf

# Payload copies are SHA-256 gated by manifest.json. Keep those bytes
# identical to the committed blobs or ValidatePayload fails after clone.
payload/**/*.ps1 text eol=lf
payload/**/*.ini text eol=lf

*.png binary
*.dll binary
*.addon64 binary
